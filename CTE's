WITH active_departments AS (
    SELECT *
    FROM departments
    WHERE active = 'active'
)
SELECT *
FROM active_departments;

WITH dept_emp_count AS (
    SELECT 
        dept_id,
        COUNT(*) AS total_employees
    FROM employees
    GROUP BY dept_id
)
SELECT *
FROM dept_emp_count;

